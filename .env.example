# 配置后启用 AI 结构化抽取；不配置时用户侧分析会明确报错
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 使用 OpenAI 兼容服务时可取消下一行注释
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8788

# 第三阶段真实平台实验（默认不启用，仍使用 Local Task Hub）
# 只有明确配置 MEETING_AGENT_CONNECTOR=feishu 后，Agent 才会把新运行路由到飞书。
# App Secret 只放在本机未提交的 .env 或系统环境变量中。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BASE_URL=https://open.feishu.cn
# FEISHU_USER_ID_TYPE=open_id
# 部署方一次性配置 OAuth 回调；普通成员只从页面“平台连接”入口点击绑定。
# 回调后系统保存被 Git 忽略的身份映射，不需要用户手写 open_id。
# 本地演示时需把该地址配置到飞书开放平台应用的重定向 URL。
# 页面会自动复制该地址并打开当前飞书应用的安全设置页，但飞书后台保存仍需部署人员确认。
# 保存完成后可直接在页面点击“我已在飞书保存”，系统会把核验状态保存到本机忽略文件。
# FEISHU_OAUTH_REDIRECT_URI=http://localhost:8788/api/integrations/feishu/oauth/callback
# 可选：OAuth 绑定完成后返回的前端地址；本地演示默认 http://localhost:5174/#workflow。
# FEISHU_OAUTH_RETURN_URL=http://localhost:5174/#workflow
# 可选部署兜底：若不通过页面按钮，也可用环境变量直接标记已核验。
# FEISHU_OAUTH_REDIRECT_VERIFIED=false
# FEISHU_IDENTITY_STORE_PATH=data/feishu-identities.json
# 调试兜底：如需绕过 OAuth，可临时手写映射；不要提交真实 ID。
# FEISHU_OWNER_MAP_JSON={"张三":"ou_xxx"}
# 可选：以下三项也可在页面“平台连接 → 飞书任务写入设置”中保存；页面保存值优先于环境变量。
# 页面可在成员 OAuth 授权后读取飞书清单并选择；也可粘贴飞书清单/分组链接并自动识别。
# 读取清单使用服务运行期内的临时用户令牌，服务重启或授权过期后需要重新绑定成员；环境变量仅作为部署兜底。
# 把创建的飞书任务直接放入指定清单/分组，便于演示时集中核对。
# FEISHU_TASKLIST_GUID=
# FEISHU_TASKLIST_SECTION_GUID=
# 创建带截止日期的任务时一并添加到期前提醒，多个规则用英文逗号分隔；1440 表示提前 1 天。
# FEISHU_DUE_REMINDER_MINUTES=1440
# 可选：在飞书任务来源里带上本系统入口；不配置时仍会标记来源为“会议行动智能体”。
# FEISHU_ORIGIN_URL=http://localhost:5174/#workflow
# 把 Agent 创建、状态同步、字段修改写入飞书任务评论；需要飞书应用具备评论权限，失败不会阻断主任务写入。
# FEISHU_SYNC_COMMENTS=false
# MEETING_AGENT_CONNECTOR=local-task
